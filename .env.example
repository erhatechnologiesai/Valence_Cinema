# ==============================================================================
# Poppy Productions - Environment Configuration
# ==============================================================================

# Hostinger SMTP Mail Configuration
# (Found in Hostinger hPanel -> Emails -> Email Accounts -> Configuration Settings)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@poppyproductions.pk
SMTP_PASSWORD=your_hostinger_email_password_here

# Where customer inquiries and briefs should be sent
CONTACT_RECEIVER_EMAIL=info@poppyproductions.pk

# Optional: Remote CRM / Google Sheets / Zapier Webhook URL
LEAD_WEBHOOK_URL=
